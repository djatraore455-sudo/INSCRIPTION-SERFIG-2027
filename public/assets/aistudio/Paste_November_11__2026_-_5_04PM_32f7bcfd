-- Commissions auxquelles l'utilisateur connecté a accès
-- (admin : toutes, avec le rôle 'admin')
create or replace function public.my_commissions()
returns table (code text, name text, member_role text)
language sql
stable
security definer
set search_path = ''
as $$
  select c.code, c.name, 'admin'::text as member_role
  from public.commissions c
  where (select private.is_serfig_admin()) and c.is_active
  union all
  select c.code, c.name, m.member_role
  from public.commission_members m
  join public.commissions c on c.code = m.commission_code
  where m.user_id = (select auth.uid())
    and not (select private.is_serfig_admin())
    and c.is_active
  order by 1;
$$;

revoke all on function public.my_commissions() from public, anon, authenticated;
grant execute on function public.my_commissions() to authenticated;

-- Changement de statut d'un besoin
create or replace function public.need_set_status(
  p_need_id uuid,
  p_status text,
  p_note text default null
)
returns void
language plpgsql
security definer
set search_path = ''
as $$
declare
  v public.commission_needs%rowtype;
  v_admin boolean;
  v_req boolean;
  v_tgt boolean;
begin
  if p_status not in ('ouvert', 'pris_en_charge', 'satisfait', 'annule') then
    raise exception 'Statut invalide : %', p_status;
  end if;

  select * into v from public.commission_needs where id = p_need_id for update;
  if not found then
    raise exception 'Besoin introuvable';
  end if;

  v_admin := (select private.is_serfig_admin());
  v_req := private.is_commission_member(v.commission_code);
  v_tgt := v.target_commission is not null
           and private.is_commission_member(v.target_commission);

  if not (v_admin or v_req or v_tgt) then
    raise exception 'Accès refusé' using errcode = '42501';
  end if;

  if not v_admin then
    if v.status in ('satisfait', 'annule') then
      raise exception 'Ce besoin est déjà clôturé';
    end if;
    if p_status = 'ouvert' then
      raise exception 'Seule la coordination peut rouvrir un besoin';
    end if;
    if p_status = 'pris_en_charge' and not v_tgt then
      raise exception 'Seule la commission sollicitée peut prendre en charge ce besoin';
    end if;
    if p_status = 'annule' and not v_req then
      raise exception 'Seule la commission demandeuse peut annuler son besoin';
    end if;
  end if;

  update public.commission_needs
  set status = p_status,
      status_note = coalesce(p_note, status_note),
      resolved_at = case when p_status in ('satisfait', 'annule') then now() else null end,
      resolved_by = case when p_status in ('satisfait', 'annule') then auth.uid() else null end
  where id = p_need_id;
end;
$$;

revoke all on function public.need_set_status(uuid, text, text)
  from public, anon, authenticated;
grant execute on function public.need_set_status(uuid, text, text) to authenticated;

-- Gestion des membres (admin) : le compte doit d'abord exister dans
-- Supabase (Authentication > Users).
create or replace function public.admin_add_commission_member(
  p_email text,
  p_commission_code text,
  p_role text default 'membre'
)
returns void
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_uid uuid;
begin
  if not (select private.is_serfig_admin()) then
    raise exception 'Accès refusé' using errcode = '42501';
  end if;
  if p_role not in ('membre', 'chef') then
    raise exception 'Rôle invalide : %', p_role;
  end if;

  select id into v_uid from auth.users
  where lower(email) = lower(btrim(p_email));

  if v_uid is null then
    raise exception 'Aucun compte avec cet e-mail : crée-le d''abord dans Supabase (Authentication > Users)';
  end if;

  insert into public.commission_members (user_id, commission_code, member_role)
  values (v_uid, p_commission_code, p_role)
  on conflict (user_id, commission_code)
  do update set member_role = excluded.member_role;
end;
$$;

create or replace function public.admin_remove_commission_member(
  p_email text,
  p_commission_code text
)
returns void
language plpgsql
security definer
set search_path = ''
as $$
begin
  if not (select private.is_serfig_admin()) then
    raise exception 'Accès refusé' using errcode = '42501';
  end if;

  delete from public.commission_members m
  using auth.users u
  where u.id = m.user_id
    and lower(u.email) = lower(btrim(p_email))
    and m.commission_code = p_commission_code;
end;
$$;

create or replace function public.admin_list_commission_members()
returns table (commission_code text, email text, member_role text)
language plpgsql
stable
security definer
set search_path = ''
as $$
begin
  if not (select private.is_serfig_admin()) then
    raise exception 'Accès refusé' using errcode = '42501';
  end if;

  return query
  select m.commission_code, u.email::text, m.member_role
  from public.commission_members m
  join auth.users u on u.id = m.user_id
  order by m.commission_code, u.email;
end;
$$;

revoke all on function public.admin_add_commission_member(text, text, text)
  from public, anon, authenticated;
revoke all on function public.admin_remove_commission_member(text, text)
  from public, anon, authenticated;
revoke all on function public.admin_list_commission_members()
  from public, anon, authenticated;
grant execute on function public.admin_add_commission_member(text, text, text) to authenticated;
grant execute on function public.admin_remove_commission_member(text, text) to authenticated;
grant execute on function public.admin_list_commission_members() to authenticated;

