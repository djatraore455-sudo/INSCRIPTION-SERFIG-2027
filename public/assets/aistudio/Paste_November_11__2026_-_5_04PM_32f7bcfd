-- ============================================================
-- SERFIG 2027 — MODULE BILAN DES COMMISSIONS
--
-- À exécuter APRÈS serfig_schema_final.sql et serfig_03 (nouvelle
-- requête dans le SQL Editor). Peut être relancé sans risque.
--
-- Principe :
--  * Chaque commission a son espace : ses membres (comptes Supabase
--    liés à la commission) écrivent UNIQUEMENT les bilans et besoins
--    de leur commission. Ils ne voient ni les participants ni les
--    paiements.
--  * Les administrateurs (coordination) voient tout et peuvent tout
--    corriger, rouvrir un bilan, gérer les membres.
--  * Un bilan = un jour = une commission : texte (fait, reste à
--    faire, perspectives, difficultés) + indicateurs chiffrés
--    + lignes de détail (consommations, manques, dépenses).
--  * Un besoin est adressé à une autre commission (ou à la
--    coordination) et suit un statut : ouvert, pris en charge,
--    satisfait, annulé. Mises à jour en temps réel.
--
-- CONFIDENTIALITÉ SANTÉ : la commission Santé saisit des NOMBRES
-- (patients reçus, urgences) et des quantités (médicaments), jamais
-- de noms ni de diagnostics individuels.
-- ============================================================

begin;

-- ------------------------------------------------------------
-- 1. COMMISSIONS ET MEMBRES
-- ------------------------------------------------------------

create table if not exists public.commissions (
  code text primary key check (code ~ '^[a-z0-9_]+$'),
  name text not null,
  sort_order integer not null default 0,
  is_active boolean not null default true,
  created_at timestamptz not null default now()
);

create table if not exists public.commission_members (
  user_id uuid not null references auth.users(id) on delete cascade,
  commission_code text not null
    references public.commissions(code) on update cascade on delete cascade,
  member_role text not null default 'membre'
    check (member_role in ('membre', 'chef')),
  created_at timestamptz not null default now(),
  primary key (user_id, commission_code)
);

create index if not exists commission_members_commission_idx
  on public.commission_members(commission_code);

-- Indicateurs chiffrés de chaque commission (modifiables par l'admin)
create table if not exists public.commission_indicators (
  id uuid primary key default gen_random_uuid(),
  commission_code text not null
    references public.commissions(code) on update cascade on delete cascade,
  indicator_key text not null check (indicator_key ~ '^[a-z0-9_]+$'),
  label text not null,
  unit text,
  sort_order integer not null default 0,
  is_active boolean not null default true,
  unique (commission_code, indicator_key)
);

-- ------------------------------------------------------------
-- 2. BILANS JOURNALIERS
-- ------------------------------------------------------------

create table if not exists public.daily_reports (
  id uuid primary key default gen_random_uuid(),
  commission_code text not null
    references public.commissions(code) on update cascade on delete restrict,
  report_date date not null,

  done text,          -- ce qui a été fait
  remaining text,     -- ce qui reste à faire
  perspectives text,  -- perspectives / prochaines actions
  difficulties text,  -- difficultés rencontrées

  status text not null default 'brouillon'
    check (status in ('brouillon', 'soumis')),
  submitted_at timestamptz,
  submitted_by uuid references auth.users(id) on delete set null,

  created_by uuid default auth.uid() references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),

  unique (commission_code, report_date)
);

create index if not exists daily_reports_date_idx
  on public.daily_reports(report_date);

-- Valeurs des indicateurs pour un bilan
create table if not exists public.report_metrics (
  report_id uuid not null references public.daily_reports(id) on delete cascade,
  indicator_id uuid not null
    references public.commission_indicators(id) on delete restrict,
  value numeric(14,2) not null check (value >= 0),
  primary key (report_id, indicator_id)
);

-- Lignes de détail : consommations (ex. médicaments), manques, dépenses
create table if not exists public.report_items (
  id uuid primary key default gen_random_uuid(),
  report_id uuid not null references public.daily_reports(id) on delete cascade,
  kind text not null check (kind in ('consommation', 'manque', 'depense')),
  label text not null check (length(btrim(label)) > 0),
  quantity numeric(14,2) check (quantity is null or quantity >= 0),
  unit text,
  created_at timestamptz not null default now()
);

create index if not exists report_items_report_idx
  on public.report_items(report_id);

-- ------------------------------------------------------------
-- 3. BESOINS EN TEMPS RÉEL
-- ------------------------------------------------------------

create table if not exists public.commission_needs (
  id uuid primary key default gen_random_uuid(),
  commission_code text not null
    references public.commissions(code) on update cascade on delete restrict,
  -- Commission à qui le besoin est adressé (null = coordination)
  target_commission text
    references public.commissions(code) on update cascade on delete set null,

  title text not null check (length(btrim(title)) > 0),
  details text,
  quantity numeric(14,2) check (quantity is null or quantity > 0),
  unit text,
  urgency text not null default 'normale'
    check (urgency in ('normale', 'haute', 'critique')),
  needed_by date,

  status text not null default 'ouvert'
    check (status in ('ouvert', 'pris_en_charge', 'satisfait', 'annule')),
  status_note text,
  resolved_at timestamptz,
  resolved_by uuid references auth.users(id) on delete set null,

  created_by uuid default auth.uid() references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),

  constraint needs_not_self_targeted
    check (target_commission is null or target_commission <> commission_code)
);

create index if not exists commission_needs_commission_idx
  on public.commission_needs(commission_code);
create index if not exists commission_needs_target_idx
  on public.commission_needs(target_commission);
create index if not exists commission_needs_status_idx
  on public.commission_needs(status);

-- ------------------------------------------------------------
-- 4. FONCTIONS D'APPARTENANCE
-- ------------------------------------------------------------

create or replace function private.is_commission_member(p_code text)
returns boolean
language sql
stable
security definer
set search_path = ''
as $$
  select exists (
    select 1
    from public.commission_members m
    where m.user_id = (select auth.uid())
      and m.commission_code = p_code
  );
$$;

revoke all on function private.is_commission_member(text) from public, anon;
grant execute on function private.is_commission_member(text) to authenticated;

