-- 5. TRIGGERS
-- ------------------------------------------------------------

create or replace function private.daily_reports_guard()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
begin
  if new.report_date > current_date then
    raise exception 'La date du bilan ne peut pas être dans le futur';
  end if;

  if tg_op = 'UPDATE' then
    if new.commission_code <> old.commission_code
       or new.report_date <> old.report_date then
      raise exception 'La commission et la date d''un bilan ne peuvent pas être modifiées';
    end if;

    if new.status = 'soumis' and old.status = 'brouillon' then
      new.submitted_at := now();
      new.submitted_by := auth.uid();
    elsif new.status = 'brouillon' and old.status = 'soumis' then
      new.submitted_at := null;
      new.submitted_by := null;
    end if;
  else
    if new.status = 'soumis' then
      new.submitted_at := now();
      new.submitted_by := auth.uid();
    end if;
  end if;

  new.updated_at := now();
  return new;
end;
$$;

drop trigger if exists daily_reports_guard on public.daily_reports;
create trigger daily_reports_guard
  before insert or update on public.daily_reports
  for each row execute function private.daily_reports_guard();

-- Un indicateur ne peut servir qu'aux bilans de sa propre commission
create or replace function private.report_metrics_guard()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
begin
  if not exists (
    select 1
    from public.daily_reports r
    join public.commission_indicators i on i.commission_code = r.commission_code
    where r.id = new.report_id and i.id = new.indicator_id
  ) then
    raise exception 'Cet indicateur n''appartient pas à la commission de ce bilan';
  end if;
  return new;
end;
$$;

drop trigger if exists report_metrics_guard on public.report_metrics;
create trigger report_metrics_guard
  before insert or update on public.report_metrics
  for each row execute function private.report_metrics_guard();

drop trigger if exists commission_needs_touch on public.commission_needs;
create trigger commission_needs_touch before update on public.commission_needs
  for each row execute function private.touch_updated_at();

